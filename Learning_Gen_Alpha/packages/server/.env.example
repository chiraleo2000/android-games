# Server Configuration
PORT=4012
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:4010/game_db
DB_POOL_MIN=10
DB_POOL_MAX=100

# Redis Configuration
REDIS_URL=redis://localhost:4011
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Session Configuration
SESSION_TIMEOUT=3600000

# Encryption Configuration (for email encryption at rest)
ENCRYPTION_SECRET=your-encryption-secret-key-change-in-production-min-32-chars
