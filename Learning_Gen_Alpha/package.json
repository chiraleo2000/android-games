{
  "name": "multiplayer-puzzle-adventure-game",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n shared,server,client -c blue,green,cyan \"npm run dev:shared\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:shared": "cd packages/shared && npm run dev",
    "dev:server": "cd packages/server && npm run dev",
    "dev:client": "cd packages/client && npm run dev",
    "build": "npm run build -w @game/shared && npm run build -w @game/server && npm run build -w @game/client",
    "test": "npm run test --workspaces --if-present",
    "test:server": "cd packages/server && npm test",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.3.3"
  }
}
