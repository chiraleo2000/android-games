{
  "name": "spellingbee-dictionary",
  "version": "1.0.0",
  "description": "SpellingBee - English spelling practice with topic words, hints, and streaks.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --test tests/releaseReadiness.test.mjs",
    "release:prepare": "node scripts/generateStoreAssets.js && node scripts/validateRelease.js",
    "store:assets": "node tools/store-assets/scripts/generate-store-assets.mjs",
    "store:validate": "node tools/store-assets/scripts/validate-store-assets.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:bundle:release": "npm run android:sync && cd android && gradlew.bat bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tslib": "^2.8.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.60.0",
    "sharp": "^0.34.5",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  }
}
